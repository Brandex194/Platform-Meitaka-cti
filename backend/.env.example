DATABASE_URL=postgresql+psycopg://sentinel_app:sentinel_app@localhost:5432/sentinel
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
KEYCLOAK_URL=http://localhost:8080
# Optional: URL the backend uses to fetch JWKS when Keycloak is not reachable at KEYCLOAK_URL
# (docker-compose sets http://keycloak:8080 for api and worker).
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-api
NVD_API_KEY=
ABUSEIPDB_KEY=
VT_KEY=
GREYNOISE_KEY=
HIBP_KEY=
GEO_IP_URL=http://ip-api.com/json
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
IOC_COLLECTOR_ENABLED=false
LEAK_COLLECTOR_ENABLED=false
EPSS_COLLECTOR_ENABLED=true
RANSOMWARE_LIVE_ENABLED=false
ABUSEIPDB_COLLECTOR_ENABLED=false
GREYNOISE_ENRICHMENT_ENABLED=false
OPENPHISH_ENABLED=false
# Encrypts the API keys stored from the Management page (VirusTotal...). Required to store one.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
