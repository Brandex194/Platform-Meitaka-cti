{
  "realm": "sentinel",
  "enabled": true,
  "displayName": "Sentinel AI (dev)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Sentinel AI role super_admin"
      },
      {
        "name": "tenant_admin",
        "description": "Sentinel AI role tenant_admin"
      },
      {
        "name": "analyst",
        "description": "Sentinel AI role analyst"
      },
      {
        "name": "viewer",
        "description": "Sentinel AI role viewer"
      },
      {
        "name": "api_user",
        "description": "Sentinel AI role api_user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sentinel-ai",
      "name": "Sentinel AI frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-sentinel-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sentinel-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sentinel-api",
      "name": "Sentinel AI API (audience only)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "super.admin",
      "enabled": true,
      "emailVerified": true,
      "email": "super.admin@sentinel.local",
      "firstName": "super.admin",
      "lastName": "dev",
      "credentials": [
        {
          "type": "password",
          "value": "sentinel-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "super_admin"
      ]
    },
    {
      "username": "tenant.admin",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant.admin@sentinel.local",
      "firstName": "tenant.admin",
      "lastName": "dev",
      "credentials": [
        {
          "type": "password",
          "value": "sentinel-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tenant_admin"
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      }
    },
    {
      "username": "analyst",
      "enabled": true,
      "emailVerified": true,
      "email": "analyst@sentinel.local",
      "firstName": "analyst",
      "lastName": "dev",
      "credentials": [
        {
          "type": "password",
          "value": "sentinel-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "analyst"
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      }
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "viewer@sentinel.local",
      "firstName": "viewer",
      "lastName": "dev",
      "credentials": [
        {
          "type": "password",
          "value": "sentinel-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      }
    },
    {
      "username": "api.user",
      "enabled": true,
      "emailVerified": true,
      "email": "api.user@sentinel.local",
      "firstName": "api.user",
      "lastName": "dev",
      "credentials": [
        {
          "type": "password",
          "value": "sentinel-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "api_user"
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
